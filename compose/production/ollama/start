#!/bin/sh

set -eu

# Start the server, wait until it answers, then make sure the model is on disk.
# The pull is a no-op after the first deploy because models live on a persistent disk.
ollama serve &
server_pid=$!

until ollama list >/dev/null 2>&1; do
    sleep 1
done

ollama pull "${OLLAMA_MODEL:-gemma4:e2b}"

wait "${server_pid}"
